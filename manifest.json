{
  "manifest_version": 3,
  "name": "GitHub to KanTanMarkdown Export",
  "version": "1.0.0",
  "description": "GitHubのMarkdownプレビュー画面から、かんたんMarkdown形式の静的HTMLをアタッチメントごとパッケージングしてエクスポートします。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://github.com/*",
    "https://*.github.io/*",
    "https://raw.githubusercontent.com/*",
    "https://*.githubusercontent.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}